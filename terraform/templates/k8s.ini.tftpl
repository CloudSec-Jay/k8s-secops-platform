# Generated by Terraform from terraform/templates/k8s.ini.tftpl. Do not edit.

[control_plane]
%{ for name, node in nodes ~}
%{ if node.role == "control_plane" ~}
${name} ansible_host=${node_ips[name]}
%{ endif ~}
%{ endfor ~}

[workers]
%{ for name, node in nodes ~}
%{ if node.role == "worker" ~}
${name} ansible_host=${node_ips[name]}
%{ endif ~}
%{ endfor ~}

[k8s_cluster:children]
control_plane
workers

[k8s_cluster:vars]
ansible_user=${vm_user}
ansible_ssh_private_key_file=${ssh_private_key}
ansible_ssh_common_args='-J ${libvirt_jumphost} -o StrictHostKeyChecking=accept-new'

