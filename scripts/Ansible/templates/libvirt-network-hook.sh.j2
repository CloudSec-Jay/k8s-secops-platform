#!/bin/bash
# Rendered by kvm-host-lan.yaml. libvirt runs this as
#   network <network> <operation> <sub-operation> <extra>
# and passes the network XML on stdin, which is not used here.
#
# Publishes the Cilium LoadBalancer IPs of the {{ libvirt_network }} network on
# the LAN: each VIP is routed to the lab bridge, the host answers ARP for it
# on {{ lan_interface }} (proxy ARP), and forwarding is allowed from the LAN to
# the VIPs on the exposed ports only. libvirt's NAT rules would otherwise
# reject new connections into the bridge.
set -eu

[ "${1:-}" = "{{ libvirt_network }}" ] || exit 0

vips="{{ lb_vips | join(' ') }}"
# Each entry is a fixed argument list for a FORWARD rule.
rules=(
  "-i {{ lan_interface }} -o {{ lab_bridge }} -s {{ lan_cidr }} -m iprange --dst-range {{ lb_vips | first }}-{{ lb_vips | last }} -p tcp -m multiport --dports {{ lan_ports | join(',') }} -m comment --comment {{ libvirt_network }}-lan -j ACCEPT"
  "-i {{ lab_bridge }} -o {{ lan_interface }} -m iprange --src-range {{ lb_vips | first }}-{{ lb_vips | last }} -d {{ lan_cidr }} -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment {{ libvirt_network }}-lan -j ACCEPT"
)

case "${2:-}" in
  started)
    for ip in $vips; do
      ip route replace "$ip/32" dev {{ lab_bridge }}
      ip neigh replace proxy "$ip" dev {{ lan_interface }}
    done
    for rule in "${rules[@]}"; do
      # shellcheck disable=SC2086 # split the fixed argument list
      iptables -C FORWARD $rule 2>/dev/null || iptables -I FORWARD 1 $rule
    done
    ;;
  stopped)
    for ip in $vips; do
      ip neigh del proxy "$ip" dev {{ lan_interface }} 2>/dev/null || true
      ip route del "$ip/32" dev {{ lab_bridge }} 2>/dev/null || true
    done
    for rule in "${rules[@]}"; do
      # shellcheck disable=SC2086 # split the fixed argument list
      iptables -D FORWARD $rule 2>/dev/null || true
    done
    ;;
esac
